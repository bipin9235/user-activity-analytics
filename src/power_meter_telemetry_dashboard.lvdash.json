        {
          "widget": {
            "name": "power_factor_counter",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "silver_telemetry",
                  "fields": [
                    {
                      "name": "avg(measurement_value)",
                      "expression": "AVG(`measurement_value`)"
                    }
                  ],
                  "filters": [
                    {
                      "expression": "`measurement_name` IN ('power_factor')"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "data": {
                "queryName": "main_query"
              },
              "encodings": {
                "value": {
                  "fieldName": "avg(measurement_value)",
                  "style": {
                    "fontColor": "#E53935",
                    "rules": [
                      {
                        "condition": {
                          "operand": {
                            "type": "data-value",
                            "value": "0.9"
                          },
                          "operator": ">="
                        },
                        "fontColor": "#43A047"
                      },
                      {
                        "condition": {
                          "operand": {
                            "type": "data-value",
                            "value": "0.8"
                          },
                          "operator": ">="
                        },
                        "fontColor": "#FB8C00"
                      }
                    ]
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": {
                  "fields": [],
                  "value": "Power Factor"
                }
              },
              "version": 2,
              "widgetType": "counter"
            },
            "specExtensions": {
              "widgetBackgroundColor": {
                "dark": "#11181C"
              }
            }
          },
          "position": {
