{
  "datasets": [
    {
      "name": "silver_telemetry",
      "displayName": "Silver Telemetry Data",
      "queryLines": [
        "SELECT\n",
        "  device_id,\n",
        "  measurement_name,\n",
        "  measurement_value,\n",
        "  measurement_time,\n",
        "  kafka_timestamp\n",
        "FROM\n",
        "  power_meter_simulator_events_silver"
      ],
      "catalog": "databricks_learning",
      "schema": "custom"
    }
  ],
  "pages": [
